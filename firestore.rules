rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isValidCategory(cat) {
      return cat is string && cat in ['educational', 'history', 'technology', 'science', 'mystery', 'storytelling'];
    }

    function isValidVoice(voiceId) {
      return voiceId is string && voiceId in ['Kore', 'Puck', 'Charon', 'Fenrir', 'Zephyr'];
    }

    function isValidVisualMode(mode) {
      return mode is string && mode in ['stock_auto', 'pexels', 'pixabay', 'wikimedia', 'ai_image'];
    }

    function isValidJobStatus(status) {
      return status is string && status in ['draft', 'script_ready', 'queued', 'processing', 'completed', 'failed'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 120))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVideoJob(data, userId, videoId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'topic', 'category', 'targetDurationSeconds',
          'voiceId', 'visualMode', 'status', 'currentStage', 'progressPercent',
          'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'topic', 'category', 'targetDurationSeconds',
          'voiceId', 'visualMode', 'status', 'currentStage', 'progressPercent',
          'source', 'createdAt', 'updatedAt', 'scriptSummary', 'outputSummary'
        ])
        && data.id is string && data.id == videoId && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid == userId && isValidId(data.ownerUid)
        && data.topic is string && data.topic.size() >= 3 && data.topic.size() <= 240
        && isValidCategory(data.category)
        && data.targetDurationSeconds is number && data.targetDurationSeconds >= 20 && data.targetDurationSeconds <= 90
        && isValidVoice(data.voiceId)
        && isValidVisualMode(data.visualMode)
        && isValidJobStatus(data.status)
        && data.currentStage is string && data.currentStage.size() >= 1 && data.currentStage.size() <= 240
        && data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.source is string && data.source in ['manual', 'scheduled']
        && (!data.keys().hasAny(['scriptSummary']) || (data.scriptSummary is string && data.scriptSummary.size() <= 2000))
        && (!data.keys().hasAny(['outputSummary']) || (data.outputSummary is string && data.outputSummary.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopicHistory(data, userId, entryId) {
      return data.keys().hasAll(['id', 'ownerUid', 'topic', 'category', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'topic', 'category', 'createdAt'])
        && data.id is string && data.id == entryId && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid == userId && isValidId(data.ownerUid)
        && data.topic is string && data.topic.size() >= 3 && data.topic.size() <= 240
        && isValidCategory(data.category)
        && data.createdAt is timestamp;
    }

    function isValidAppSettings(data, userId) {
      return data.keys().hasAll([
          'ownerUid', 'preferredVisualProvider', 'resolution', 'fps', 'subtitleStyle', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'preferredVisualProvider', 'resolution', 'fps', 'subtitleStyle', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == userId && isValidId(data.ownerUid)
        && data.preferredVisualProvider is string && data.preferredVisualProvider in ['stock_first', 'ai_image_first']
        && data.resolution is string && data.resolution == '1080x1920'
        && data.fps is number && data.fps == 30
        && data.subtitleStyle is string && data.subtitleStyle in ['bold_centered', 'minimal_bottom']
        && data.updatedAt is timestamp;
    }

    function isValidAutomationConfig(data, userId) {
      return data.keys().hasAll([
          'ownerUid', 'enabled', 'videosPerDay', 'scheduleTimesUtc',
          'defaultCategory', 'defaultDurationSeconds', 'defaultVoiceId',
          'defaultVisualMode', 'preventDuplicatesWindowDays', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'enabled', 'videosPerDay', 'scheduleTimesUtc',
          'defaultCategory', 'defaultDurationSeconds', 'defaultVoiceId',
          'defaultVisualMode', 'preventDuplicatesWindowDays', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == userId && isValidId(data.ownerUid)
        && data.enabled is bool
        && data.videosPerDay is number && data.videosPerDay >= 1 && data.videosPerDay <= 4
        && data.scheduleTimesUtc is list
        && data.scheduleTimesUtc.size() >= 1 && data.scheduleTimesUtc.size() <= 6
        && data.scheduleTimesUtc[0] is string && data.scheduleTimesUtc[0].size() <= 10
        && data.defaultCategory is string && (data.defaultCategory == 'rotate' || isValidCategory(data.defaultCategory))
        && data.defaultDurationSeconds is number && data.defaultDurationSeconds >= 20 && data.defaultDurationSeconds <= 90
        && isValidVoice(data.defaultVoiceId)
        && isValidVisualMode(data.defaultVisualMode)
        && data.preventDuplicatesWindowDays is number && data.preventDuplicatesWindowDays >= 1 && data.preventDuplicatesWindowDays <= 365
        && data.updatedAt is timestamp;
    }

    function isValidAutomationRun(data, userId, runId) {
      return data.keys().hasAll(['id', 'ownerUid', 'slotKey', 'triggeredAt', 'status', 'message'])
        && data.keys().hasOnly(['id', 'ownerUid', 'slotKey', 'triggeredAt', 'status', 'videoId', 'message'])
        && data.id is string && data.id == runId && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid == userId && isValidId(data.ownerUid)
        && data.slotKey is string && data.slotKey.size() >= 1 && data.slotKey.size() <= 64
        && data.triggeredAt is timestamp
        && data.status is string && data.status in ['pending', 'running', 'completed', 'failed', 'skipped_duplicate']
        && (!data.keys().hasAny(['videoId']) || (data.videoId is string && isValidId(data.videoId)))
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt']);
      allow delete: if false;

      match /videos/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && isOwner(userId) && existing().ownerUid == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(videoId)
          && isVerifiedOwner(userId)
          && isValidVideoJob(incoming(), userId, videoId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(videoId)
          && isVerifiedOwner(userId)
          && isValidVideoJob(incoming(), userId, videoId)
          && existing().ownerUid == request.auth.uid
          && existing().status != 'completed'
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'voiceId', 'visualMode', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentStage', 'progressPercent', 'updatedAt'])
          );
        allow delete: if isValidId(userId)
          && isValidId(videoId)
          && isVerifiedOwner(userId)
          && existing().ownerUid == request.auth.uid
          && existing().status != 'processing';
      }

      match /topicHistory/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && existing().ownerUid == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isVerifiedOwner(userId)
          && isValidTopicHistory(incoming(), userId, entryId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(entryId) && isVerifiedOwner(userId) && existing().ownerUid == request.auth.uid;
      }

      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId) && existing().ownerUid == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(settingId)
          && isVerifiedOwner(userId)
          && isValidAppSettings(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(settingId)
          && isVerifiedOwner(userId)
          && isValidAppSettings(incoming(), userId)
          && existing().ownerUid == request.auth.uid
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['preferredVisualProvider', 'subtitleStyle', 'updatedAt']);
        allow delete: if false;
      }

      match /automation/{configId} {
        allow get: if isValidId(userId) && isValidId(configId) && isOwner(userId) && existing().ownerUid == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(configId)
          && isVerifiedOwner(userId)
          && isValidAutomationConfig(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(configId)
          && isVerifiedOwner(userId)
          && isValidAutomationConfig(incoming(), userId)
          && existing().ownerUid == request.auth.uid
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'enabled', 'videosPerDay', 'scheduleTimesUtc', 'defaultCategory',
            'defaultDurationSeconds', 'defaultVoiceId', 'defaultVisualMode',
            'preventDuplicatesWindowDays', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /automationRuns/{runId} {
        allow get: if isValidId(userId) && isValidId(runId) && isOwner(userId) && existing().ownerUid == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(runId)
          && isVerifiedOwner(userId)
          && isValidAutomationRun(incoming(), userId, runId)
          && incoming().triggeredAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
