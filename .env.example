# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (Cloud Run injects PORT, defaults to 3000).
PORT=3000

# GCS_BUCKET_NAME: Google Cloud Storage bucket for permanent MP4 and asset storage.
GCS_BUCKET_NAME=""

# PEXELS_API_KEY: Optional licensed stock video/photo provider key (free tier available).
PEXELS_API_KEY=""

# PIXABAY_API_KEY: Optional licensed stock video/photo provider key (free tier available).
PIXABAY_API_KEY=""

# SCHEDULER_SECRET: Shared secret token sent by Google Cloud Scheduler in X-Scheduler-Secret header.
SCHEDULER_SECRET=""
